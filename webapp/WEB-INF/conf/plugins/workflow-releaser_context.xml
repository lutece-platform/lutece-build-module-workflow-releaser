    <bean id="workflow-releaser.taskTypeReleaseFromTagPrepare"
        class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
        p:key="taskReleaseFromTagPrepare" p:titleI18nKey="module.workflow.releaser.taskReleaseFromTagPrepareTitle"
        p:beanName="workflow-releaser.taskReleaseFromTagPrepare"
        p:taskForAutomaticAction="true" />

    <bean id="workflow-releaser.taskReleaseFromTagPrepare"
        class="fr.paris.lutece.plugins.workflow.modules.releaser.service.TaskReleaseFromTagPrepare" />

    <!-- Task Release from tag : deploy to Nexus -->
    <bean id="workflow-releaser.taskTypeReleaseFromTagDeploy"
        class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
        p:key="taskReleaseFromTagDeploy" p:titleI18nKey="module.workflow.releaser.taskReleaseFromTagDeployTitle"
        p:beanName="workflow-releaser.taskReleaseFromTagDeploy"
        p:taskForAutomaticAction="true" />

    <bean id="workflow-releaser.taskReleaseFromTagDeploy"
        class="fr.paris.lutece.plugins.workflow.modules.releaser.service.TaskReleaseFromTagDeploy" />

    <!-- Task Release from tag : update master* version -->
    <bean id="workflow-releaser.taskTypeReleaseFromTagUpdateMaster"
        class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
        p:key="taskReleaseFromTagUpdateMaster" p:titleI18nKey="module.workflow.releaser.taskReleaseFromTagUpdateMasterTitle"
        p:beanName="workflow-releaser.taskReleaseFromTagUpdateMaster"
        p:taskForAutomaticAction="true" />

    <bean id="workflow-releaser.taskReleaseFromTagUpdateMaster"
        class="fr.paris.lutece.plugins.workflow.modules.releaser.service.TaskReleaseFromTagUpdateMaster" />

