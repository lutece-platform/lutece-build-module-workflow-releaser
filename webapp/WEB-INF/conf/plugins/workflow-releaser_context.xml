    <bean id="workflow-releaser.taskTypeReleaseFromTagBumpDevelop"
        class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
        p:key="taskReleaseFromTagBumpDevelop" p:titleI18nKey="module.workflow.releaser.taskReleaseFromTagBumpDevelopTitle"
        p:beanName="workflow-releaser.taskReleaseFromTagBumpDevelop"
        p:taskForAutomaticAction="true" />

    <bean id="workflow-releaser.taskReleaseFromTagBumpDevelop"
        class="fr.paris.lutece.plugins.workflow.modules.releaser.service.TaskReleaseFromTagBumpDevelop" />

    <!-- Task Release from tag : ours-merge develop into master -->
    <bean id="workflow-releaser.taskTypeReleaseFromTagMarkOurs"
        class="fr.paris.lutece.plugins.workflowcore.business.task.TaskType"
        p:key="taskReleaseFromTagMarkOurs" p:titleI18nKey="module.workflow.releaser.taskReleaseFromTagMarkOursTitle"
        p:beanName="workflow-releaser.taskReleaseFromTagMarkOurs"
        p:taskForAutomaticAction="true" />

    <bean id="workflow-releaser.taskReleaseFromTagMarkOurs"
        class="fr.paris.lutece.plugins.workflow.modules.releaser.service.TaskReleaseFromTagMarkOurs" />
